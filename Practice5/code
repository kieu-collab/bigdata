# ================================================================
# 16. PANDAS
# ================================================================

def run_pandas():

    df = pd.read_parquet(
        PARQUET_PATH,
        columns=USE_COLS,
        engine="pyarrow"
    )

    df = df.dropna(
        subset=USE_COLS
    )

    df = df[
        df[FILTER_COL]
        > FILTER_THRESHOLD
    ]

    result = (

        df.groupby(
            GROUP_COL,
            sort=False
        )

        .agg(
            n_rows=(
                VALUE_COL,
                "size"
            ),

            sum_value=(
                VALUE_COL,
                "sum"
            ),

            mean_value=(
                VALUE_COL,
                "mean"
            )
        )

        .reset_index()
    )

    result = result.rename(
        columns={
            GROUP_COL:
            "group_key"
        }
    )

    return result


# ================================================================
# 17. POLARS
# ================================================================

def run_polars():

    q = (
        pl.scan_parquet(
            PARQUET_PATH
        )

        .select(
            USE_COLS
        )

        .filter(
            pl.col(GROUP_COL)
              .is_not_null()

            &

            pl.col(VALUE_COL)
              .is_not_null()

            &

            pl.col(FILTER_COL)
              .is_not_null()

            &

            (
                pl.col(FILTER_COL)
                > FILTER_THRESHOLD
            )
        )

        .group_by(
            GROUP_COL
        )

        .agg(

            pl.len()
              .alias(
                  "n_rows"
              ),

            pl.col(VALUE_COL)
              .sum()
              .alias(
                  "sum_value"
              ),

            pl.col(VALUE_COL)
              .mean()
              .alias(
                  "mean_value"
              )
        )
    )

    result = q.collect(
        engine="streaming"
    )

    result = (
        result
        .rename(
            {
                GROUP_COL:
                "group_key"
            }
        )
        .to_pandas()
    )

    return result


# ================================================================
# 18. DUCKDB
# ================================================================

def sql_identifier(name):

    return (
        '"'
        + name.replace(
            '"',
            '""'
        )
        + '"'
    )


def run_duckdb():

    g = sql_identifier(
        GROUP_COL
    )

    v = sql_identifier(
        VALUE_COL
    )

    f = sql_identifier(
        FILTER_COL
    )

    path_sql = (
        PARQUET_PATH
        .replace(
            "'",
            "''"
        )
    )

    con = duckdb.connect(
        database=":memory:"
    )

    con.execute(
        f"""
        SET threads={CPU_COUNT}
        """
    )

    query = f"""
    SELECT

        {g}
            AS group_key,

        COUNT(*)
            AS n_rows,

        SUM(
            CAST(
                {v}
                AS DOUBLE
            )
        )
            AS sum_value,

        AVG(
            CAST(
                {v}
                AS DOUBLE
            )
        )
            AS mean_value

    FROM
        read_parquet(
            '{path_sql}'
        )

    WHERE
        {g} IS NOT NULL

        AND
        {v} IS NOT NULL

        AND
        {f} IS NOT NULL

        AND
        CAST(
            {f}
            AS DOUBLE
        )
        >
        {FILTER_THRESHOLD}

    GROUP BY
        {g}
    """

    result = (
        con.execute(
            query
        )
        .fetchdf()
    )

    con.close()

    return result


# ================================================================
# 19. DASK
# ================================================================

def run_dask():

    df = dd.read_parquet(
        PARQUET_PATH,
        columns=USE_COLS
    )

    df = df.dropna(
        subset=USE_COLS
    )

    df = df[
        df[FILTER_COL]
        > FILTER_THRESHOLD
    ]

    result = (

        df.groupby(
            GROUP_COL
        )[VALUE_COL]

        .agg(
            [
                "count",
                "sum",
                "mean"
            ]
        )

        .compute(
            scheduler="threads",
            num_workers=CPU_COUNT
        )

        .reset_index()
    )

    result = result.rename(
        columns={
            GROUP_COL:
                "group_key",

            "count":
                "n_rows",

            "sum":
                "sum_value",

            "mean":
                "mean_value"
        }
    )

    return result


