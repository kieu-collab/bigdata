# ================================================================
# 24. BENCHMARK
#
# The order is randomized each round to reduce
# systematic cache-order bias.
#
# What is timed:
#
#   Read Parquet
#       +
#   Projection
#       +
#   Filter
#       +
#   GroupBy
#       +
#   Count/Sum/Mean
#       +
#   Materialize result
#
# What is NOT timed:
#
#   pip installation
#   Ray startup
#   Spark startup
# ================================================================

timings = {
    tool: []
    for tool in TOOLS
}

last_outputs = {}

errors = {}


print("\n" + "=" * 80)
print("STARTING BENCHMARK")
print("=" * 80)


for run_idx in range(
    N_RUNS
):

    print(
        f"\n===== ROUND "
        f"{run_idx + 1}"
        f"/{N_RUNS} ====="
    )

    tool_order = list(
        TOOLS.items()
    )

    rng = random.Random(
        RANDOM_SEED
        + run_idx
    )

    rng.shuffle(
        tool_order
    )

    for tool_name, function in tool_order:

        if tool_name in errors:
            continue

        gc.collect()

        try:

            start = (
                time.perf_counter()
            )

            output = function()

            elapsed = (
                time.perf_counter()
                - start
            )

            timings[
                tool_name
            ].append(
