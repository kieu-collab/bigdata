def run_vaex():

    df = vaex.open(
        PARQUET_PATH
    )

    # Remove missing/NaN values from
    # the benchmark columns.

    df = df.dropna(
        column_names=USE_COLS
    )

    df = df[
        df[FILTER_COL]
        > FILTER_THRESHOLD
    ]

    result = df.groupby(

        GROUP_COL,

        agg={

            "n_rows":
                vaex.agg.count(),

            "sum_value":
                vaex.agg.sum(
                    VALUE_COL
                ),

            "mean_value":
                vaex.agg.mean(
                    VALUE_COL
                )
        }
    )

    result = (
        result
        .to_pandas_df()
        .rename(
            columns={
                GROUP_COL:
                "group_key"
            }
        )
    )

    return result


