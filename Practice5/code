def run_pyspark():

    df = (

        spark.read
        .parquet(
            PARQUET_PATH
        )

        .select(
            *USE_COLS
        )
    )

    df = df.filter(

        F.col(
            GROUP_COL
        ).isNotNull()

        &

        F.col(
            VALUE_COL
        ).isNotNull()

        &

        F.col(
            FILTER_COL
        ).isNotNull()

        &

        (
            F.col(
                FILTER_COL
            )
            >
            F.lit(
                FILTER_THRESHOLD
            )
        )
    )

    result = (

        df.groupBy(
            GROUP_COL
        )

        .agg(

            F.count(
                F.lit(1)
            ).alias(
                "n_rows"
            ),

            F.sum(
                F.col(
                    VALUE_COL
                ).cast(
                    "double"
                )
            ).alias(
                "sum_value"
            ),

            F.avg(
                F.col(
                    VALUE_COL
                ).cast(
                    "double"
                )
            ).alias(
                "mean_value"
            )
        )

        .withColumnRenamed(
            GROUP_COL,
            "group_key"
        )

        .toPandas()
    )

    return result


