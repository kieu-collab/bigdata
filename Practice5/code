# ================================================================
# 29. VALIDATION AGAINST PANDAS
# ================================================================

if (
    "Pandas"
    in last_outputs
):

    reference = output_signature(
        last_outputs[
            "Pandas"
        ]
    )

    checks = []

    for tool_name, df_result in last_outputs.items():

        sig = output_signature(
            df_result
        )

        same_groups = (
            sig["Groups"]
            ==
            reference["Groups"]
        )

        same_rows = (
            sig["Filtered_rows"]
            ==
            reference["Filtered_rows"]
        )

        same_sum = np.isclose(

            sig["Total_sum"],

            reference[
                "Total_sum"
            ],

            rtol=1e-5,
            atol=1e-5
        )

        checks.append(
            {
                "Tool":
                    tool_name,

                "Same_groups":
                    same_groups,

                "Same_rows":
                    same_rows,

                "Same_sum":
                    bool(
                        same_sum
                    ),

                "VALID":
                    (
                        same_groups
                        and same_rows
                        and same_sum
                    )
            }
        )

    check_df = pd.DataFrame(
        checks
    )

    print(
        "\nConsistency with Pandas:"
    )

    display(
        check_df
    )


