# ================================================================
# 28. VALIDATE RESULTS
#
# We check:
#   - number of groups
#   - number of filtered rows
#   - global sum
#
# Small floating point differences are allowed.
# ================================================================

def output_signature(
    df
):

    x = df.copy()

    n_groups = len(
        x
    )

    n_rows = int(
        pd.to_numeric(
            x["n_rows"],
            errors="coerce"
        )
        .fillna(0)
        .sum()
    )

    total_sum = float(
        pd.to_numeric(
            x["sum_value"],
            errors="coerce"
        )
        .fillna(0)
        .sum()
    )

    return {
        "Groups":
            n_groups,

        "Filtered_rows":
            n_rows,

        "Total_sum":
            total_sum
    }


validation_rows = []

for tool_name, df_result in last_outputs.items():

    try:

        sig = output_signature(
            df_result
        )

        validation_rows.append(
            {
                "Tool":
                    tool_name,

                **sig
            }
        )

    except Exception:
        pass


validation_df = pd.DataFrame(
    validation_rows
)


print("\n" + "=" * 80)
