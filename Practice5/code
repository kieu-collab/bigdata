# ================================================================
# 9. HELPER FUNCTIONS FOR AUTOMATIC COLUMN SELECTION
# ================================================================

def sample_nunique(column):

    try:
        return int(
            sample_df[column]
            .nunique(dropna=True)
        )

    except Exception:
        return 10**12


def choose_by_keyword(
    candidates,
    keywords
):

    if not candidates:
        return None

    for keyword in keywords:

        for column in candidates:

            if keyword in column.lower():
                return column

    return None


# Common business-data keywords.

GROUP_HINTS = [
    "country",
    "category",
    "segment",
    "region",
    "state",
    "city",
    "department",
    "product",
    "brand",
    "channel",
    "status",
    "type",
    "class",
    "group"
]

VALUE_HINTS = [
    "revenue",
