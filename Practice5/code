]


# ================================================================
# 10. AUTO-DETECT GROUP COLUMN
# ================================================================

if GROUP_COL is None:

    # Prefer categorical fields with reasonable
    # cardinality.

    reasonable_cat = [

        c for c in categorical_cols

        if (
            2
            <= sample_nunique(c)
            <= 5_000
        )
    ]

    GROUP_COL = choose_by_keyword(
        reasonable_cat,
        GROUP_HINTS
    )

    if GROUP_COL is None and reasonable_cat:

        GROUP_COL = min(
            reasonable_cat,
            key=sample_nunique
        )


    # If no suitable text/category column,
    # try a low-cardinality numeric column.

    if GROUP_COL is None:

        numeric_group_candidates = [

            c for c in numeric_cols

            if (
                2
                <= sample_nunique(c)
                <= 1_000
            )
        ]

        GROUP_COL = choose_by_keyword(
            numeric_group_candidates,
            GROUP_HINTS
        )

        if (
            GROUP_COL is None
            and numeric_group_candidates
        ):

            GROUP_COL = min(
                numeric_group_candidates,
                key=sample_nunique
            )


    # Last fallback.

    if GROUP_COL is None:

        if categorical_cols:

            GROUP_COL = min(
                categorical_cols,
                key=sample_nunique
            )

        else:

            GROUP_COL = min(
                numeric_cols,
                key=sample_nunique
