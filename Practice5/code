def run_ray():

    # Ray workers use local:///
    # for an explicit local path.

    ray_path = (
        "local://"
        + PARQUET_PATH
    )

    ds = ray.data.read_parquet(
        ray_path,
        columns=USE_COLS
    )

    expression = (

        col(GROUP_COL)
        .is_not_null()

        &

        col(VALUE_COL)
        .is_not_null()

        &

        col(FILTER_COL)
        .is_not_null()

        &

        (
            col(FILTER_COL)
            > FILTER_THRESHOLD
        )
    )

    ds = ds.filter(
        expr=expression
    )

    result_ds = (

        ds.groupby(
            GROUP_COL
        )

        .aggregate(

            Count(
                alias_name=
                "n_rows"
            ),

            Sum(
                on=VALUE_COL,
                alias_name=
                "sum_value"
            ),

            Mean(
                on=VALUE_COL,
                alias_name=
                "mean_value"
            )
        )
    )

    result = pd.DataFrame(
        result_ds.take_all()
    )

    result = result.rename(
        columns={
            GROUP_COL:
            "group_key"
        }
    )

    return result


